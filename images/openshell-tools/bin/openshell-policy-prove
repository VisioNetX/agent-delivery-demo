#!/bin/sh
# Kargo step: prove that an agent's OpenShell policy grants nothing beyond a
# stage's boundary policy. Any result other than within_boundary fails the
# promotion, including "unsupported" and "inconclusive".
#
# Usage: openshell-policy-prove --policy <POLICY> --boundary <FILE> [--timeout <TIMEOUT>]
#
# --policy is the candidate policy, named as in `openshell policy set`.
# --boundary and --timeout are passed to `openshell-prover check`.
set -eu

usage="usage: openshell-policy-prove --policy <POLICY> --boundary <FILE> [--timeout <TIMEOUT>]"
policy=""
boundary=""
timeout=60s
while [ $# -gt 0 ]; do
  case "$1" in
    --policy) policy="$2"; shift 2 ;;
    --policy=*) policy="${1#*=}"; shift ;;
    --boundary) boundary="$2"; shift 2 ;;
    --boundary=*) boundary="${1#*=}"; shift ;;
    --timeout) timeout="$2"; shift 2 ;;
    --timeout=*) timeout="${1#*=}"; shift ;;
    -h|--help) echo "$usage"; exit 0 ;;
    *) echo "openshell-policy-prove: unknown argument: $1" >&2; echo "$usage" >&2; exit 2 ;;
  esac
done
if [ -z "$policy" ] || [ -z "$boundary" ]; then
  echo "$usage" >&2
  exit 2
fi

set +e
openshell-prover check "$policy" --boundary "$boundary" --timeout "$timeout" --output json > /tmp/prove.json
rc=$?
set -e

python3 - "$rc" "$policy" "$boundary" <<'EOF'
import json, os, sys

import yaml


def describe(example):
    """One line of access the candidate allows and the boundary doesn't."""
    if isinstance(example, dict) and example.get("domain") == "network":
        target = f"{example.get('host')}:{example.get('port')}"
        if example.get("method"):
            return f"{example['method']} {target}{example.get('path', '')}"
        return f"connect {target}"
    return json.dumps(example) if not isinstance(example, str) else example


class BlockDumper(yaml.SafeDumper):
    """Writes multi-line strings, such as logs, as YAML blocks."""


BlockDumper.add_representer(str, lambda dumper, value: dumper.represent_scalar(
    "tag:yaml.org,2002:str", value, style="|" if "\n" in value else None))

rc, policy, boundary = int(sys.argv[1]), sys.argv[2], sys.argv[3]
with open("/tmp/prove.json") as f:
    result = json.load(f)
summary = result.get("result", "error")
example = describe(result["counterexample"]) if result.get("counterexample") else None

logs = [f"Checking {policy} against boundary {boundary}", f"result: {summary}"]
if example:
    logs.append(f"exceeds boundary: {example}")
if result.get("reason"):
    logs.append(f"reason: {result['reason']}")
if rc != 0:
    logs.append("Policy is NOT within the boundary: blocking promotion.")
print("\n".join(logs))

# Outputs, shown in the step's Output tab whether it passes or fails.
output = {"result": summary}
if example:
    output["exceedsBoundary"] = example
output.update({"policy": policy, "boundary": boundary, "logs": "\n".join(logs)})
out = os.environ.get("KARGO_OUTPUT")
if out:
    with open(out, "w") as f:
        yaml.dump(output, f, Dumper=BlockDumper, sort_keys=False, allow_unicode=True, width=1000)
EOF

exit "$rc"
