#!/usr/bin/env python3
"""Kargo step: make the stage's OpenShell sandbox run the promoted agent bundle.

Usage:
  openshell-sandbox-apply --name <NAME> --from <IMAGE> --policy <POLICY>
                          --provider <PROVIDER> --upload <LOCAL_PATH>[:<SANDBOX_PATH>]
                          [--env <KEY=VALUE> ...] [--no-git-ignore]

The flags are those of `openshell sandbox create`. Run it again with the same
flags and it updates the sandbox to match, instead of failing because the
sandbox exists.

OpenShell decides what can change in place:
  - The image, environment variables, filesystem rules and process rules are
    fixed at creation. If any of them changed, the sandbox is deleted and
    created again.
  - Network rules hot-reload, and the bundle files (prompt, tools, model config)
    are read on every request. Those are applied in place with
    `openshell policy set --wait` and `openshell sandbox upload`.

To tell the two apart, the script hashes the image, the environment variables
and the creation-time part of the policy (everything but the network rules), and stores the hash in the
sandbox's startup-hash label. The next run compares its hash with the label:
a match means update in place, a difference means recreate. Safe to re-run.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys

import yaml

STARTUP_LABEL = "startup-hash"

# What the step did, as printed: returned in its outputs as `logs`, so the
# Kargo UI shows it for a successful step too.
logs = []


def log(line):
    print(line, flush=True)
    logs.append(line)


def openshell(*args, check=True, quiet=False):
    """Run the openshell CLI, logging the command and its output. With quiet,
    the output is only returned, for output the script parses."""
    cmd = ["openshell", *args]
    log("+ " + " ".join(cmd))
    result = subprocess.run(cmd, text=True, capture_output=True)
    if not quiet:
        for text, stream in ((result.stdout, sys.stdout), (result.stderr, sys.stderr)):
            if text:
                stream.write(text)
                stream.flush()
                logs.extend(line.rstrip() for line in text.rstrip("\n").splitlines())
    if check and result.returncode != 0:
        raise subprocess.CalledProcessError(result.returncode, cmd, result.stdout, result.stderr)
    return result


class BlockDumper(yaml.SafeDumper):
    """Writes multi-line strings, such as logs, as YAML blocks."""


BlockDumper.add_representer(str, lambda dumper, value: dumper.represent_scalar(
    "tag:yaml.org,2002:str", value, style="|" if "\n" in value else None))


def find_label(obj, key):
    """Find a label value anywhere in `openshell sandbox get -o json` output."""
    if isinstance(obj, dict):
        labels = obj.get("labels")
        if isinstance(labels, dict) and key in labels:
            return labels[key]
        for value in obj.values():
            found = find_label(value, key)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find_label(value, key)
            if found is not None:
                return found
    return None


def parse_args():
    parser = argparse.ArgumentParser(
        description="Create an OpenShell sandbox, or update it to match if it exists.")
    parser.add_argument("--name", required=True)
    parser.add_argument("--from", dest="image", required=True, metavar="IMAGE")
    parser.add_argument("--policy", required=True)
    parser.add_argument("--provider", action="append", default=[], help="repeatable")
    parser.add_argument("--upload", required=True, metavar="LOCAL_PATH[:SANDBOX_PATH]")
    parser.add_argument("--env", action="append", default=[], metavar="KEY=VALUE", help="repeatable")
    parser.add_argument("--no-git-ignore", action="store_true", help="don't apply .gitignore rules to --upload")
    return parser.parse_args()


def main():
    args = parse_args()
    name, image, policy_file = args.name, args.image, args.policy
    env = sorted(e for e in args.env if e)
    local_path, _, sandbox_path = args.upload.partition(":")
    upload_flags = ["--no-git-ignore"] if args.no_git_ignore else []
    subprocess.run(["openshell-login"], check=True)
    with open(policy_file) as f:
        policy = yaml.safe_load(f)

    startup = {k: v for k, v in policy.items() if k not in ("network_policies", "network_middlewares")}
    startup_hash = hashlib.sha256(
        json.dumps({"image": image, "env": env, "policy": startup}, sort_keys=True).encode()
    ).hexdigest()[:16]

    existing = openshell("sandbox", "get", name, "-o", "json", check=False, quiet=True)
    current_hash = None
    if existing.returncode == 0:
        current_hash = find_label(json.loads(existing.stdout), STARTUP_LABEL)

    if current_hash == startup_hash:
        reason = "image, environment and startup policy unchanged, updating in place"
        log(f"{name}: {reason}")
        openshell("policy", "set", name, "--policy", policy_file, "--wait")
        openshell("sandbox", "upload", *upload_flags, name, local_path, *([sandbox_path] if sandbox_path else []))
        action = "updated"
    else:
        if existing.returncode == 0:
            reason = f"image, environment or startup policy changed ({current_hash} -> {startup_hash}), recreating"
            log(f"{name}: {reason}")
            openshell("sandbox", "delete", name)
        else:
            reason = "no sandbox yet, creating"
            log(f"{name}: {reason}")
        create = [
            "sandbox", "create",
            "--name", name,
            "--from", image,
            "--policy", policy_file,
            "--upload", args.upload,
            *upload_flags,
            "--detach",
            # Labels are only set at creation, so this holds only what can't
            # change without a recreate.
            "--label", f"{STARTUP_LABEL}={startup_hash}",
        ]
        for provider in args.provider:
            create += ["--provider", provider]
        for e in env:
            create += ["--env", e]
        openshell(*create)
        action = "recreated" if existing.returncode == 0 else "created"

    output = {
        "action": action,
        "sandbox": name,
        "reason": reason,
        "startupHash": startup_hash,
        "logs": "\n".join(logs),
    }
    out = os.environ.get("KARGO_OUTPUT")
    if out:
        with open(out, "w") as f:
            yaml.dump(output, f, Dumper=BlockDumper, sort_keys=False, allow_unicode=True, width=1000)


if __name__ == "__main__":
    main()
