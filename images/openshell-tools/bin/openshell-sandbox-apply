#!/usr/bin/env python3
"""Kargo step: make the stage's OpenShell sandbox run the promoted agent bundle.

Usage:
  openshell-sandbox-apply --name <NAME> --from <IMAGE> --policy <POLICY>
                          --provider <PROVIDER> --upload <LOCAL_PATH>[:<SANDBOX_PATH>]

The flags are those of `openshell sandbox create`. Run it again with the same
flags and it updates the sandbox to match, instead of failing because the
sandbox exists.

OpenShell decides what can change in place:
  - The image, filesystem rules and process rules are fixed at creation. If any
    of them changed, the sandbox is deleted and created again.
  - Network rules hot-reload, and the bundle files (prompt, tools, model config)
    are read on every request. Those are applied in place with
    `openshell policy set --wait` and `openshell sandbox upload`.

To tell the two apart, the script hashes the image plus the creation-time part
of the policy (everything but the network rules), and stores the hash in the
sandbox's startup-hash label. The next run compares its hash with the label:
a match means update in place, a difference means recreate. Safe to re-run.
"""

import argparse
import hashlib
import json
import os
import subprocess

import yaml

STARTUP_LABEL = "startup-hash"


def openshell(*args, check=True, capture=False):
    cmd = ["openshell", *args]
    print("+ " + " ".join(cmd), flush=True)
    return subprocess.run(cmd, check=check, text=True, capture_output=capture)


def find_label(obj, key):
    """Find a label value anywhere in `openshell sandbox get -o json` output."""
    if isinstance(obj, dict):
        labels = obj.get("labels")
        if isinstance(labels, dict) and key in labels:
            return labels[key]
        for value in obj.values():
            found = find_label(value, key)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find_label(value, key)
            if found is not None:
                return found
    return None


def parse_args():
    parser = argparse.ArgumentParser(
        description="Create an OpenShell sandbox, or update it to match if it exists.")
    parser.add_argument("--name", required=True)
    parser.add_argument("--from", dest="image", required=True, metavar="IMAGE")
    parser.add_argument("--policy", required=True)
    parser.add_argument("--provider", action="append", default=[], help="repeatable")
    parser.add_argument("--upload", required=True, metavar="LOCAL_PATH[:SANDBOX_PATH]")
    return parser.parse_args()


def main():
    args = parse_args()
    name, image, policy_file = args.name, args.image, args.policy
    local_path, _, sandbox_path = args.upload.partition(":")
    subprocess.run(["openshell-login"], check=True)
    with open(policy_file) as f:
        policy = yaml.safe_load(f)

    startup = {k: v for k, v in policy.items() if k not in ("network_policies", "network_middlewares")}
    startup_hash = hashlib.sha256(
        json.dumps({"image": image, "policy": startup}, sort_keys=True).encode()
    ).hexdigest()[:16]

    existing = openshell("sandbox", "get", name, "-o", "json", check=False, capture=True)
    current_hash = None
    if existing.returncode == 0:
        current_hash = find_label(json.loads(existing.stdout), STARTUP_LABEL)

    if current_hash == startup_hash:
        print(f"{name}: image and startup policy unchanged, updating in place")
        openshell("policy", "set", name, "--policy", policy_file, "--wait")
        openshell("sandbox", "upload", name, local_path, *([sandbox_path] if sandbox_path else []))
        action = "updated"
    else:
        if existing.returncode == 0:
            print(f"{name}: image or startup policy changed ({current_hash} -> {startup_hash}), recreating")
            openshell("sandbox", "delete", name)
        create = [
            "sandbox", "create",
            "--name", name,
            "--from", image,
            "--policy", policy_file,
            "--upload", args.upload,
            "--detach",
            # Labels are only set at creation, so this holds only what can't
            # change without a recreate.
            "--label", f"{STARTUP_LABEL}={startup_hash}",
        ]
        for provider in args.provider:
            create += ["--provider", provider]
        openshell(*create)
        action = "created"

    out = os.environ.get("KARGO_OUTPUT")
    if out:
        with open(out, "a") as f:
            f.write(f"action={action}\nsandbox={name}\nstartupHash={startup_hash}\n")


if __name__ == "__main__":
    main()
